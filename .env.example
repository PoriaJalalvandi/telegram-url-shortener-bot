# Safe local template. Copy to .env, replace placeholders, then explicitly export
# variables in your shell. Python does NOT automatically load .env files.
APP_ENV=development
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# Comma-separated numeric Telegram user IDs. Empty denies all admin access.
TELEGRAM_ADMIN_IDS=
BASE_URL=http://127.0.0.1:5000
DATABASE_PATH=./url_shortener.db
FLASK_DEBUG=0

# Optional proxies. Use HTTPS_PROXY or ALL_PROXY for Telegram HTTPS requests.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
